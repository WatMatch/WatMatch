{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "mid2-review-*": false } },
  "services": {
    "backend": {
      "root": "src/backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "client": {
      "root": "src/client",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
