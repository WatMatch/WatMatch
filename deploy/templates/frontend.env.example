# Copy outside Git to /etc/watmatch/frontend.env with mode 0600.
# NEXT_PUBLIC_* values must also match the values used for npm run build.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_PREVIEW_READ_ONLY=true
NEXT_PUBLIC_MILESTONE_FEEDBACK_ENABLED=false
