# Copy outside Git to /etc/watmatch/backend.env with mode 0600.
# Fill these from the existing project's approved configuration.
SUPABASE_URL=
# Current backend requires a legacy service_role JWT; sb_secret_* is unsupported.
SUPABASE_SERVICE_ROLE_KEY=
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8080
CORS_ORIGINS=http://127.0.0.1:8080
WATMATCH_READ_ONLY=true
WATMATCH_REQUIRE_SYNC_CLOCK=true
WATMATCH_MILESTONE_FEEDBACK_ENABLED=false
